+#if defined(GLES_HOST_EAGL) && !defined(GLES_HOST_ANGLE)
+/* gles_host_call_inner with rectangle textures re-aimed at GL_TEXTURE_2D (see the comment above gles_rect_note). */
+static int64_t gles_host_call_1(CPUState *cpu, uint32_t slot, uint32_t ctx,
+                                uint32_t argc, const uint32_t *a)
+{
+    uint32_t b[16];
+    bool rect = false;                  /* this call named the rectangle target */
+    GLfloat saved[GLES_RECT_UNITS][16];
+    GLint old_active = 0, old_mode = 0;
+    unsigned mask = 0;
+    int64_t r;
+
+    if (!gles_rect2d_enabled() || argc == 0 || argc > 16) {
+        return gles_host_call_inner(cpu, slot, ctx, argc, a);
+    }
+    memcpy(b, a, argc * sizeof(*b));
+    switch (slot) {
+    case GLES_SLOT_ENABLE:
+    case GLES_SLOT_DISABLE:
+    case GLES_SLOT_IS_ENABLED:
+    case GLES_SLOT_BIND_TEXTURE:
+    case GLES_SLOT_TEX_IMAGE_2D:
+    case GLES_SLOT_TEX_SUB_IMAGE_2D:
+    case GLES_SLOT_COMPRESSED_TEX_IMAGE_2D:
+    case GLES_SLOT_COMPRESSED_TEX_SUB_IMAGE_2D:
+    case GLES_SLOT_COPY_TEX_IMAGE_2D:
+    case GLES_SLOT_COPY_TEX_SUB_IMAGE_2D:
+    case GLES_SLOT_TEX_PARAMETERFV:
+    case GLES_SLOT_TEX_PARAMETERIV:
+    case GLES_SLOT_GET_TEX_PARAMETERFV:
+    case GLES_SLOT_GET_TEX_PARAMETERIV:
+        if (b[0] == GLES_RECT_TARGET) {
+            b[0] = GL_TEXTURE_2D;
+            rect = true;
+        }
+        break;
+    case GLES_SLOT_FB_TEXTURE_2D:       /* target, attachment, textarget, texture, level: CoreAnimation renders into rectangles */
+        if (argc >= 3 && b[2] == GLES_RECT_TARGET) {
+            b[2] = GL_TEXTURE_2D;
+        }
+        break;
+    case GLES_SLOT_TEX_PARAMETERI:
+    case GLES_SLOT_TEX_PARAMETERF:
+        if (b[0] == GLES_RECT_TARGET) {
+            b[0] = GL_TEXTURE_2D;
+            rect = true;
+            if (argc >= 3) {
+                bool is_float = slot == GLES_SLOT_TEX_PARAMETERF;
+                uint32_t value = is_float ? (uint32_t)gles_u2f(b[2]) : b[2];
+
+                if (b[1] == GL_TEXTURE_WRAP_S || b[1] == GL_TEXTURE_WRAP_T) {
+                    value = GL_CLAMP_TO_EDGE;                   /* a rectangle only clamps */
+                } else if (b[1] == GL_TEXTURE_MIN_FILTER && value >= 0x2700 && value <= 0x2703) {
+                    value = (value & 1) ? GL_LINEAR : GL_NEAREST;   /* ...and has no mipmaps */
+                }
+                b[2] = is_float ? gles_f2u((float)value) : value;
+            }
+        }
+        break;
+    case GLES_SLOT_GET_INTEGERV:
+    case GLES_SLOT_GET_BOOLEANV:
+    case GLES_SLOT_GET_FLOATV:
+        if (b[0] == GLES_RECT_BINDING) {
+            b[0] = GL_TEXTURE_BINDING_2D;
+        } else if (b[0] == GLES_RECT_MAX_SIZE) {
+            b[0] = GL_MAX_TEXTURE_SIZE;
+        }
+        break;
+    case GLES_SLOT_DRAW_ARRAYS:
+    case GLES_SLOT_DRAW_ELEMENTS:
+        mask = gles_rect_draw_begin(saved, &old_active, &old_mode);
+        break;
+    default:
+        break;
+    }
+
+    r = gles_host_call_inner(cpu, slot, ctx, argc, b);
+
+    if (mask) {
+        gles_rect_draw_end(mask, saved, old_active, old_mode);
+    }
+    if (r >= 0) {
+        switch (slot) {
+        case GLES_SLOT_BIND_TEXTURE:
+            if (argc >= 2) {
+                gles_rect_bound(b[1], rect);
+            }
+            break;
+        case GLES_SLOT_TEX_IMAGE_2D:
+        case GLES_SLOT_COMPRESSED_TEX_IMAGE_2D:
+            if (rect && argc >= 5) {
+                gles_rect_note_bound(b[3], b[4]);
+            }
+            break;
+        case GLES_SLOT_COPY_TEX_IMAGE_2D:
+            if (rect && argc >= 7) {
+                gles_rect_note_bound(b[5], b[6]);
+            }
+            break;
+        default:
+            break;
+        }
+    }
+    return r;
+}
+#endif
