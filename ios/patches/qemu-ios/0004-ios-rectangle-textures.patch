+#if defined(GLES_HOST_EAGL) && !defined(GLES_HOST_ANGLE)
+/*
+ * Rectangle textures on an ES 1.1 host.
+ *
+ * The iPod touch 2G's QuartzCore composites through GL_TEXTURE_RECTANGLE (target 0x84F5, texture coordinates in
+ * texels, clamp-to-edge only). An iOS GL ES context has no such target, so every bind raised GL_INVALID_ENUM, the
+ * surface attach was refused, and CoreAnimation fell back to a path that drew a frame every few seconds.
+ *
+ * Here a rectangle texture is a plain 2D texture the host remembers the size of. The guest's calls are re-aimed at
+ * GL_TEXTURE_2D (see gles_host_call_1), and a draw that samples such a texture gets the texture matrix
+ * S * M, S = scale(1/width, 1/height): the guest's matrix M still works in texels, and the texture reads normalised
+ * coordinates, which is what a 2D texture wants. A non-power-of-two 2D texture is complete on iOS as long as it
+ * clamps to the edge and has no mipmaps, so those two are forced on rectangles.
+ * IT_GLES_RECT2D=0 turns the whole thing off (the app has a switch for it).
+ */
+#define GLES_RECT_TARGET    0x84F5
+#define GLES_RECT_BINDING   0x84F6
+#define GLES_RECT_MAX_SIZE  0x84F8
+#define GLES_RECT_UNITS     2
+
+static GHashTable *gles_rects;          /* host texture name -> (width << 16) | height; 0 until the size is known */
+
+static bool gles_rect2d_enabled(void)
+{
+    static int on = -1;
+
+    if (on < 0) {
+        const char *v = getenv("IT_GLES_RECT2D");
+        on = v ? atoi(v) != 0 : 1;
+    }
+    return on;
+}
+
+static void gles_rect_note(GLuint name, uint32_t w, uint32_t h)
+{
+    if (!name || w > 0xffff || h > 0xffff) {
+        return;
+    }
+    if (!gles_rects) {
+        gles_rects = g_hash_table_new(g_direct_hash, g_direct_equal);
+    }
+    g_hash_table_insert(gles_rects, GUINT_TO_POINTER(name), GUINT_TO_POINTER((w << 16) | h));
+}
+
+static void gles_rect_note_bound(uint32_t w, uint32_t h)
+{
+    GLint name = 0;
+
+    glGetIntegerv(GL_TEXTURE_BINDING_2D, &name);
+    gles_rect_note(name, w, h);
+}
+
+/* The texture was just bound as a rectangle (new: a rectangle's default state) or as a real 2D texture (forget it). */
+static void gles_rect_bound(uint32_t name, bool rectangle)
+{
+    if (!name) {
+        return;
+    }
+    if (!rectangle) {
+        if (gles_rects) {
+            g_hash_table_remove(gles_rects, GUINT_TO_POINTER(name));
+        }
+        return;
+    }
+    if (!gles_rects || !g_hash_table_contains(gles_rects, GUINT_TO_POINTER(name))) {
+        gles_rect_note(name, 0, 0);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    }
+}
+
+/* Before a draw: every unit sampling a rectangle gets S * M. Returns the units changed. */
+static unsigned gles_rect_draw_begin(GLfloat saved[GLES_RECT_UNITS][16], GLint *old_active, GLint *old_mode)
+{
+    unsigned mask = 0;
+
+    if (!gles_rects || !g_hash_table_size(gles_rects)) {
+        return 0;
+    }
+    glGetIntegerv(GL_ACTIVE_TEXTURE, old_active);
+    glGetIntegerv(GL_MATRIX_MODE, old_mode);
+    for (unsigned u = 0; u < GLES_RECT_UNITS; u++) {
+        GLint name = 0;
+        gpointer v;
+        uint32_t w, h;
+
+        glActiveTexture(GL_TEXTURE0 + u);
+        glGetIntegerv(GL_TEXTURE_BINDING_2D, &name);
+        if (!name || !g_hash_table_lookup_extended(gles_rects, GUINT_TO_POINTER(name), NULL, &v)) {
+            continue;
+        }
+        w = GPOINTER_TO_UINT(v) >> 16;
+        h = GPOINTER_TO_UINT(v) & 0xffff;
+        if (!w || !h) {
+            continue;
+        }
+        glMatrixMode(GL_TEXTURE);
+        glGetFloatv(GL_TEXTURE_MATRIX, saved[u]);
+        glLoadIdentity();
+        glScalef(1.0f / w, 1.0f / h, 1.0f);
+        glMultMatrixf(saved[u]);
+        mask |= 1u << u;
+    }
+    glActiveTexture(*old_active);
+    glMatrixMode(*old_mode);
+    return mask;
+}
+
+static void gles_rect_draw_end(unsigned mask, GLfloat saved[GLES_RECT_UNITS][16], GLint old_active, GLint old_mode)
+{
+    for (unsigned u = 0; u < GLES_RECT_UNITS; u++) {
+        if (mask & (1u << u)) {
+            glActiveTexture(GL_TEXTURE0 + u);
+            glMatrixMode(GL_TEXTURE);
+            glLoadMatrixf(saved[u]);
+        }
+    }
+    glActiveTexture(old_active);
+    glMatrixMode(old_mode);
+}
+
+static uint32_t gles_f2u(float f)
+{
+    uint32_t u;
+
+    memcpy(&u, &f, sizeof(u));
+    return u;
+}
+
+static float gles_u2f(uint32_t u)
+{
+    float f;
+
+    memcpy(&f, &u, sizeof(f));
+    return f;
+}
+#endif /* rectangle textures on an ES 1.1 host */
