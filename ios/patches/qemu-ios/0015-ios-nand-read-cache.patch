diff --git a/hw/arm/nand-image.c b/hw/arm/nand-image.c
index b4f9b0d1fd..2f84e96f57 100644
--- a/hw/arm/nand-image.c
+++ b/hw/arm/nand-image.c
@@ -33,8 +33,56 @@ struct NANDImage {
     uint8_t *blank;    /* what a hole reads as: the stored XOR key */
     uint8_t *buffer;
     VMChangeStateEntry *vm_state;
+    /*
+     * A direct-mapped read cache of whole records (post-XOR, as a read returns them). Each emulated flash read is a
+     * blocking blk_pread that parks the vCPU until it finishes, and an iOS 4 boot does an enormous number of them
+     * (data protection decrypts the system a page at a time), so the guest spends most of a boot stalled on storage
+     * while the host sits idle. A hit here serves the page from RAM with no block-layer round trip. Read-only data:
+     * a write updates its own slot and an erase drops the block's slots, so the cache can never hand back stale or
+     * lost data -- at worst a slot is dropped and re-read. IT_NAND_CACHE sets the slot count (a power of two, 0 to
+     * turn the cache off); the default is 8192 slots, about 17 MB for an A4's 2 KB+ records.
+     */
+    uint32_t cache_slots;          /* 0 while uninitialised or disabled; else a power of two */
+    uint64_t *cache_key;           /* (chip << 40 | page) + 1 per slot, 0 = empty */
+    uint8_t *cache_data;           /* cache_slots * stride bytes */
+    uint64_t cache_hits, cache_misses;   /* for the periodic hit-rate line (diagnostics only) */
 };
 
+/* The slot a (chip, page) maps to: a multiplicative hash so power-of-two page strides don't all collide. */
+static inline uint32_t nand_cache_slot(NANDImage *n, unsigned chip, uint32_t page)
+{
+    uint64_t key = ((uint64_t)chip << 40) | page;
+    return (uint32_t)((key * 0x9E3779B97F4A7C15ULL) >> 40) & (n->cache_slots - 1);
+}
+
+/* The non-zero key a slot holds for (chip, page). */
+static inline uint64_t nand_cache_key(unsigned chip, uint32_t page)
+{
+    return (((uint64_t)chip << 40) | page) + 1;
+}
+
+/* Allocates the cache on the first read, once the stride is known. Off if IT_NAND_CACHE=0 or allocation fails. */
+static void nand_cache_init(NANDImage *n)
+{
+    const char *env = getenv("IT_NAND_CACHE");
+    uint32_t slots = env ? (uint32_t)strtoul(env, NULL, 0) : 8192;
+
+    n->cache_slots = 0;
+    if (slots == 0 || (slots & (slots - 1)) != 0) {
+        return;                    /* disabled, or not a power of two */
+    }
+    n->cache_key = g_try_new0(uint64_t, slots);
+    n->cache_data = g_try_malloc((size_t)slots * n->stride);
+    if (!n->cache_key || !n->cache_data) {
+        g_free(n->cache_key);
+        g_free(n->cache_data);
+        n->cache_key = NULL;
+        n->cache_data = NULL;
+        return;
+    }
+    n->cache_slots = slots;
+}
+
 BlockBackend *nand_image_open_file(DeviceState *owner, const char *path,
                                    size_t size, bool writable, Error **errp)
 {
@@ -159,6 +207,8 @@ static void nand_image_free(NANDImage *n)
     }
     g_free(n->blank);
     g_free(n->buffer);
+    g_free(n->cache_key);
+    g_free(n->cache_data);
     g_free(n);
 }
 
@@ -193,6 +243,7 @@ NANDImage *nand_image_open(DeviceState *owner, const char *dir,
     n = g_new0(NANDImage, 1);
     n->geo = *geo;
     n->stride = geo->page_bytes + geo->spare_bytes;
+    nand_cache_init(n);   /* the read cache (off if IT_NAND_CACHE=0 or it cannot be allocated) */
     n->blank = g_malloc(n->stride);
     n->buffer = g_malloc(n->stride);
     if (!nand_image_blank(qdict_get_try_str(g, "blank"), n->blank, geo->page_bytes, geo->spare_bytes)) {
@@ -225,6 +276,20 @@ static void nand_image_xor(NANDImage *n, uint8_t *out, const uint8_t *in)
     }
 }
 
+/* A hit-rate line now and then, only with diagnostics on (the app's IT_VCPU_ACCT), so we can see if the cache earns
+ * its keep without spamming a release build. */
+static void nand_cache_report(NANDImage *n)
+{
+    uint64_t total = n->cache_hits + n->cache_misses;
+
+    if ((total & 0x3FFFF) == 0 && getenv("IT_VCPU_ACCT")) {
+        fprintf(stderr, "[nand] read cache %llu%% of %llu reads (%llu hit, %llu miss)\n",
+                (unsigned long long)(total ? n->cache_hits * 100 / total : 0),
+                (unsigned long long)total, (unsigned long long)n->cache_hits,
+                (unsigned long long)n->cache_misses);
+    }
+}
+
 int nand_image_read(NANDImage *n, unsigned chip, uint32_t page, uint8_t *record)
 {
     int result;
@@ -232,6 +297,28 @@ int nand_image_read(NANDImage *n, unsigned chip, uint32_t page, uint8_t *record)
     if (nand_image_bad(n, chip, page)) {
         return -EINVAL;
     }
+    if (n->cache_slots) {
+        uint32_t slot = nand_cache_slot(n, chip, page);
+        uint64_t key = nand_cache_key(chip, page);
+        uint8_t *line = n->cache_data + (size_t)slot * n->stride;
+        if (n->cache_key[slot] == key) {
+            memcpy(record, line, n->stride);
+            n->cache_hits++;
+            nand_cache_report(n);
+            return 0;
+        }
+        n->cache_misses++;
+        nand_cache_report(n);
+        /* bounded: nand_image_bad checked chip */
+        result = blk_pread(n->chip[chip], (int64_t)page * n->stride, n->stride, record, 0);
+        if (result < 0) {
+            return result;
+        }
+        nand_image_xor(n, record, record);
+        memcpy(line, record, n->stride);
+        n->cache_key[slot] = key;
+        return 0;
+    }
     /* bounded: nand_image_bad checked chip */
     result = blk_pread(n->chip[chip], (int64_t)page * n->stride, n->stride, record, 0);
     if (result < 0) {
@@ -252,6 +339,13 @@ int nand_image_write(NANDImage *n, unsigned chip, uint32_t page, const uint8_t *
 
     if (result < 0) {
         qatomic_set(&nand_image_failed, true);
+        return result;
+    }
+    /* Keep the cache coherent: this page now reads back `record`. */
+    if (n->cache_slots) {
+        uint32_t slot = nand_cache_slot(n, chip, page);
+        memcpy(n->cache_data + (size_t)slot * n->stride, record, n->stride);
+        n->cache_key[slot] = nand_cache_key(chip, page);
     }
     return result;
 }
@@ -270,6 +364,17 @@ int nand_image_erase(NANDImage *n, unsigned chip, uint32_t block)
 
     if (result < 0) {
         qatomic_set(&nand_image_failed, true);
+        return result;
+    }
+    /* Those pages read blank now: drop any cached copies of them. */
+    if (n->cache_slots) {
+        for (uint32_t i = 0; i < n->geo.pages_per_block; i++) {
+            uint32_t page = (uint32_t)first + i;
+            uint32_t slot = nand_cache_slot(n, chip, page);
+            if (n->cache_key[slot] == nand_cache_key(chip, page)) {
+                n->cache_key[slot] = 0;
+            }
+        }
     }
     return result;
 }
