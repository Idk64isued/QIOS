diff --git a/accel/tcg/tb-jmp-cache.h b/accel/tcg/tb-jmp-cache.h
index 1773650b28..8a469145c7 100644
--- a/accel/tcg/tb-jmp-cache.h
+++ b/accel/tcg/tb-jmp-cache.h
@@ -35,9 +35,19 @@ typedef struct CPUJumpCache {
     CPUJumpCacheBank *bank;
     /* The bank epoch this cache was last emptied in; stale if behind. */
     uint64_t epoch;
+    /*
+     * The cache's generation (atomic): an entry counts only while its own
+     * @gen matches, so emptying the cache is one increment rather than a
+     * store to every entry. The iOS port's guests invalidate CF_PCREL TBs
+     * hundreds of times a second while an app loads (each one empties every
+     * vCPU's cache), and the stores to 16K entries per cache made that the
+     * main loop's hottest path.
+     */
+    uint32_t gen;
     struct {
         TranslationBlock *tb;
         vaddr pc;
+        uint32_t gen;
     } array[TB_JMP_CACHE_SIZE];
 } CPUJumpCache;
 
@@ -73,9 +83,22 @@ struct CPUJumpCacheBank {
 
 static inline void tb_jmp_cache_empty(CPUJumpCache *jc)
 {
-    for (int i = 0; i < TB_JMP_CACHE_SIZE; i++) {
-        qatomic_set(&jc->array[i].tb, NULL);
+    uint32_t gen = qatomic_fetch_inc(&jc->gen) + 1;
+
+    /* Once every 2^32 empties the generations wrap: really empty it then. */
+    if (unlikely(gen == 0)) {
+        for (int i = 0; i < TB_JMP_CACHE_SIZE; i++) {
+            qatomic_set(&jc->array[i].tb, NULL);
+            jc->array[i].gen = 0;
+        }
+        qatomic_set(&jc->gen, 1);
     }
 }
 
+/* Whether entry @i of @jc is current (its TB may still be NULL). */
+static inline bool tb_jmp_cache_current(CPUJumpCache *jc, uint32_t i)
+{
+    return jc->array[i].gen == qatomic_read(&jc->gen);
+}
+
 #endif /* ACCEL_TCG_TB_JMP_CACHE_H */
