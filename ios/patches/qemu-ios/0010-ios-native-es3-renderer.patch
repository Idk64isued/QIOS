+/*
+ * The GL bridge on the iPhone's own OpenGL ES (iOS hosts): gles-host.c built a third time through the ANGLE adapter
+ * (gles-host-angle.c.inc), with its GL from OpenGLES.framework and its contexts from EAGL instead of ANGLE's
+ * libraries. A guest ES 1.1 context is an EAGL ES 1.1 context and a guest ES 2.0 one an EAGL ES 3.0 context, so the
+ * shader devices (S5L8920, A4) draw on the iPhone's GPU without ANGLE. Chosen per boot: -M ...,gl-renderer=es3.
+ * Contexts of the two APIs can't share objects in EAGL (a sharegroup is one API's), so they don't; ES 1.1 and ES 2.0
+ * guest contexts meet through surfaces (guest memory), which is how CoreAnimation hands layers around anyway.
+ */
+#define GLES_HOST_ANGLE 1
+#define GLES_HOST_NATIVE_ES3 1
+#define gles_host_call gles_es3_host_call
+#define gles_host_stats gles_es3_host_stats
+#define gles_host_set_allowed gles_es3_host_set_allowed
+#define gles_host_reset gles_es3_host_reset
+#define gles_host_context_count gles_es3_host_context_count
+#define gles_host_refuse gles_es3_host_refuse
+#define gles_host_rejects gles_es3_host_rejects
+#define gles_host_set_debug gles_es3_host_set_debug
+#define gles_host_debug gles_es3_host_debug
+#define gles_host_ram_gen gles_es3_host_ram_gen
+#include "gles-host.c"
+
+bool gles_es3_host_available(void);
+bool gles_es3_host_available(void)
+{
+    return gles_angle_load();
+}
