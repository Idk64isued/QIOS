+
+/* ---------------------------------------------------------------- IOSurface
+ * The frame buffer's color attachment as an IOSurface, as gles-host-eagl.c does for EAGL: ANGLE's
+ * EGL_ANGLE_iosurface_client_buffer makes a pbuffer of one, and eglBindTexImage puts that pbuffer behind the texture
+ * the caller has bound -- in place of its glTexImage2D. On Metal the texture IS the IOSurface's memory, so a present
+ * is a copy out of a mapped page instead of a glReadPixels: the readback that drains a tile-based GPU every frame. */
+#include <IOSurface/IOSurfaceRef.h>
+#ifndef EGL_IOSURFACE_ANGLE
+#define EGL_IOSURFACE_ANGLE 0x3454
+#define EGL_IOSURFACE_PLANE_ANGLE 0x345A
+#define EGL_TEXTURE_RECTANGLE_ANGLE 0x345B
+#define EGL_TEXTURE_TYPE_ANGLE 0x345C
+#define EGL_TEXTURE_INTERNAL_FORMAT_ANGLE 0x345D
+#endif
+#ifndef EGL_BIND_TO_TEXTURE_TARGET_ANGLE
+#define EGL_BIND_TO_TEXTURE_TARGET_ANGLE 0x348D
+#endif
+static IOSurfaceRef angle_surf;
+static EGLSurface angle_surf_pbuffer = EGL_NO_SURFACE;
+
+static void angle_dict_set_int(CFMutableDictionaryRef d, CFStringRef key, int v)
+{
+    CFNumberRef n = CFNumberCreate(kCFAllocatorDefault, kCFNumberIntType, &v);
+    if (n) {
+        CFDictionarySetValue(d, key, n);
+        CFRelease(n);
+    }
+}
+
+static bool gles_angle_iosurface_bind(uint32_t w, uint32_t h)
+{
+    if (angle_display == EGL_NO_DISPLAY) return false;
+    if (angle_surf_pbuffer != EGL_NO_SURFACE) {
+        /* Already made (one frame buffer per process, like EAGL's): behind whichever texture is bound now. */
+        eglReleaseTexImage(angle_display, angle_surf_pbuffer, EGL_BACK_BUFFER);
+        return eglBindTexImage(angle_display, angle_surf_pbuffer, EGL_BACK_BUFFER);
+    }
+    const char *ext = eglQueryString(angle_display, EGL_EXTENSIONS);
+    if (!ext || !strstr(ext, "EGL_ANGLE_iosurface_client_buffer")) {
+        fprintf(stderr, "[gles-angle] no EGL_ANGLE_iosurface_client_buffer; presenting by readback\n");
+        return false;
+    }
+    /* The texture target this config binds an IOSurface to: GL_TEXTURE_2D on Metal (the macOS GL backend's is a
+     * rectangle, which the frame buffer's GL_TEXTURE_2D attachment can't be). */
+    EGLint target = 0;
+    if (!eglGetConfigAttrib(angle_display, angle_config, EGL_BIND_TO_TEXTURE_TARGET_ANGLE, &target) ||
+        target != EGL_TEXTURE_2D) {
+        fprintf(stderr, "[gles-angle] IOSurfaces bind to target 0x%x here, not GL_TEXTURE_2D; presenting by readback\n",
+                target);
+        return false;
+    }
+    CFMutableDictionaryRef props = CFDictionaryCreateMutable(kCFAllocatorDefault, 0, &kCFTypeDictionaryKeyCallBacks,
+                                                             &kCFTypeDictionaryValueCallBacks);
+    if (!props) return false;
+    angle_dict_set_int(props, kIOSurfaceWidth, (int)w);
+    angle_dict_set_int(props, kIOSurfaceHeight, (int)h);
+    angle_dict_set_int(props, kIOSurfaceBytesPerElement, 4);
+    angle_dict_set_int(props, kIOSurfacePixelFormat, 0x42475241); /* 'BGRA', the guest's CoreAnimation order */
+    angle_surf = IOSurfaceCreate(props);
+    CFRelease(props);
+    if (!angle_surf) {
+        fprintf(stderr, "[gles-angle] IOSurfaceCreate failed; presenting by readback\n");
+        return false;
+    }
+    EGLint attrs[] = {
+        EGL_WIDTH, (EGLint)w,
+        EGL_HEIGHT, (EGLint)h,
+        EGL_IOSURFACE_PLANE_ANGLE, 0,
+        EGL_TEXTURE_TARGET, EGL_TEXTURE_2D,
+        EGL_TEXTURE_INTERNAL_FORMAT_ANGLE, GL_BGRA_EXT,
+        EGL_TEXTURE_FORMAT, EGL_TEXTURE_RGBA,
+        EGL_TEXTURE_TYPE_ANGLE, GL_UNSIGNED_BYTE,
+        EGL_NONE,
+    };
+    angle_surf_pbuffer = eglCreatePbufferFromClientBuffer(angle_display, EGL_IOSURFACE_ANGLE,
+                                                          (EGLClientBuffer)angle_surf, angle_config, attrs);
+    if (angle_surf_pbuffer == EGL_NO_SURFACE) {
+        fprintf(stderr, "[gles-angle] ANGLE refused the IOSurface pbuffer; presenting by readback\n");
+        CFRelease(angle_surf);
+        angle_surf = NULL;
+        return false;
+    }
+    if (!eglBindTexImage(angle_display, angle_surf_pbuffer, EGL_BACK_BUFFER)) {
+        fprintf(stderr, "[gles-angle] eglBindTexImage failed; presenting by readback\n");
+        eglDestroySurface(angle_display, angle_surf_pbuffer);
+        angle_surf_pbuffer = EGL_NO_SURFACE;
+        CFRelease(angle_surf);
+        angle_surf = NULL;
+        return false;
+    }
+    fprintf(stderr, "[gles-angle] frame buffer on an IOSurface (%ux%u, %zu bytes a row)\n",
+            w, h, IOSurfaceGetBytesPerRow(angle_surf));
+    return true;
+}
+
+/* The frame's first byte, rows bottom-up, or NULL (the caller reads back for this frame). The caller has flushed;
+ * ANGLE's Metal command buffers are its own, so wait for them here before the CPU looks at the surface. */
+static void *gles_angle_iosurface_lock(size_t *stride)
+{
+    if (!angle_surf) return NULL;
+    glFinish();
+    if (IOSurfaceLock(angle_surf, kIOSurfaceLockReadOnly, NULL) != 0) return NULL;
+    void *base = IOSurfaceGetBaseAddress(angle_surf);
+    if (!base) {
+        IOSurfaceUnlock(angle_surf, kIOSurfaceLockReadOnly, NULL);
+        return NULL;
+    }
+    *stride = IOSurfaceGetBytesPerRow(angle_surf);
+    return base;
+}
+
+static void gles_angle_iosurface_unlock(void)
+{
+    if (angle_surf) IOSurfaceUnlock(angle_surf, kIOSurfaceLockReadOnly, NULL);
+}
+
 #endif /* GLES_HOST_NATIVE_ES3 */
 
