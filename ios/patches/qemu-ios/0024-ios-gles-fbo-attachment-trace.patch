From 1b474a35e52fc333101fa1a2b89feb32196cc961 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 21 Nov 2026 21:01:18 -0700
Subject: [PATCH] ios: say whether the framebuffer attachment call ever reached
 the host

On 6.x the guest's OpenGLES carries its dispatch record without field
names, so the shim names a slot only by decoding the exported trampoline
that loads it, and reaches 309 of 914. A slot it cannot name is a call it
never forwards: the host does not refuse it, does not see it, and cannot
know it was made. The symptom is an app drawing correctly, at full speed,
into a framebuffer that has nothing attached -- Minecraft on 6.1.3, whose
FBO reports MISSING_ATTACHMENT while 1200 draws a second go nowhere.

Two updates were spent guessing which side of the bridge that gap is on.
The guest-side diagnostic that would answer it (0022) is compiled into a
binary this build installs prebuilt and cannot rebuild, so it has never
once run. This measures the same thing from the side we do build: every
call marks its wire id on the way in, and the incomplete-framebuffer
report reads them back, naming the whole framebuffer family and saying
plainly whether an attachment call arrived and failed or never arrived.

Those are different bugs. If it arrived, the fault is in this host's FBO
handling and is ours to fix. If it did not, the slot is unnamed and the
fix is a per-firmware slot map, which is a much larger job -- and worth
knowing before it is started rather than after.

Co-Authored-By: Claude Opus 4.6 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01UGCtLRD1vYicb9wVRzGR7X
---
 hw/arm/gles-host.c | 62 ++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 62 insertions(+)

diff --git a/hw/arm/gles-host.c b/hw/arm/gles-host.c
index 98ac6fb9ad..9b82e01e8b 100644
--- a/hw/arm/gles-host.c
+++ b/hw/arm/gles-host.c
@@ -2237,6 +2237,48 @@ static int64_t gles_reject(GLenum error)
 static GHashTable *gles_rejects;
 static bool gles_debug;
 
+/*
+ * Which GL entry points have ever reached this host, by wire id.
+ *
+ * On 6.x and 7.x the guest's OpenGLES carries its dispatch record without field
+ * names, so the shim can only name a slot by decoding the exported trampoline
+ * that loads it -- and it reaches 309 of 914. A slot it cannot name is a call
+ * the shim never forwards: the host does not refuse it, does not see it, and
+ * has no way to know it was made. The symptom is an app whose framebuffer never
+ * receives its attachment and which then draws, correctly and at full speed,
+ * into nothing.
+ *
+ * Two rounds were spent guessing which side that gap was on, because the guest
+ * diagnostic that would have said is in a binary this build installs prebuilt
+ * and cannot rebuild. This one is on the side we do build. Every call marks its
+ * id on the way in, and the incomplete-framebuffer report below reads them back,
+ * so the log says plainly whether the attachment call arrived and failed or
+ * never arrived at all. Those are different bugs with different fixes.
+ */
+#define GLES_SEEN_MAX 1024
+static uint8_t gles_seen_wire[GLES_SEEN_MAX / 8];
+
+static inline void gles_seen_mark(uint32_t id)
+{
+    if (id < GLES_SEEN_MAX) {
+        gles_seen_wire[id >> 3] |= 1u << (id & 7);
+    }
+}
+
+static inline bool gles_seen(uint32_t id)
+{
+    return id < GLES_SEEN_MAX && (gles_seen_wire[id >> 3] & (1u << (id & 7))) != 0;
+}
+
+/* The framebuffer-object family, by the wire ids in gles-names.h. If an app is
+ * drawing into an incomplete framebuffer, the answer is in here. */
+static const struct { uint32_t id; const char *name; } gles_fbo_family[] = {
+    { 666, "glBindRenderbuffer" },      { 668, "glGenRenderbuffers" },
+    { 669, "glRenderbufferStorage" },   { 672, "glBindFramebuffer" },
+    { 674, "glGenFramebuffers" },       { 675, "glCheckFramebufferStatus" },
+    { 677, "glFramebufferTexture2D" },  { 679, "glFramebufferRenderbuffer" },
+};
+
 static bool gles_reject_note(const char *name, uint64_t n, bool at_least)
 {
     uint64_t *count;
@@ -2896,9 +2938,27 @@ static void gles_check_fb_complete(void)
         return;
     }
     if (gles_refuse("fb-incomplete:0x%x", st)) {
+        size_t i;
+        bool any_attach = gles_seen(677) || gles_seen(679);
+
         fprintf(stderr, "[gles] DRAWING INTO INCOMPLETE framebuffer %u (host %u, "
                 "status 0x%x) -- this draw produces nothing\n",
                 gh.bound_framebuffer, gles_host_fbo(gh.bound_framebuffer), st);
+        /*
+         * 0x8cd7 is MISSING_ATTACHMENT: nothing is attached at all. Either the
+         * attach call reached this host and failed, or it never reached it --
+         * which on 6.x means the shim could not name its dispatch slot. Say
+         * which, with the whole family, once per distinct status.
+         */
+        fprintf(stderr, "[gles]   calls this host has seen:");
+        for (i = 0; i < ARRAY_SIZE(gles_fbo_family); i++) {
+            fprintf(stderr, " %s=%s", gles_fbo_family[i].name,
+                    gles_seen(gles_fbo_family[i].id) ? "yes" : "NO");
+        }
+        fprintf(stderr, "\n[gles]   %s\n", any_attach
+                ? "an attachment call did reach the host: the attachment itself failed"
+                : "NO attachment call has ever reached the host -- the guest never sent one, "
+                  "so its dispatch slot is one of the unnamed ones");
     }
 }
 
@@ -6708,6 +6768,8 @@ static int64_t gles_host_call_1(CPUState *cpu, uint32_t slot, uint32_t ctx,
         return -1;
     }
 
+    gles_seen_mark(slot);
+
     switch (slot) {
 
     /* ---- engine-level operations (not framework dispatch slots) ---- */
-- 
