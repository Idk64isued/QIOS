+/* "live-refresh-hz": the panel's frame rate, changed while running (the app's automatic cool-down). */
+static void lcd_set_live_refresh(Object *obj, Visitor *v, const char *name, void *opaque, Error **errp)
+{
+    uint32_t hz;
+
+    if (!visit_type_uint32(v, name, &hz, errp)) {
+        return;
+    }
+    if (hz < 1 || hz > 240) {
+        error_setg(errp, "refresh-hz must be 1 to 240, not %u", hz);
+        return;
+    }
+    IPOD_TOUCH_LCD(obj)->refresh_hz = hz;
+}
+
+static void lcd_get_live_refresh(Object *obj, Visitor *v, const char *name, void *opaque, Error **errp)
+{
+    uint32_t hz = IPOD_TOUCH_LCD(obj)->refresh_hz;
+
+    visit_type_uint32(v, name, &hz, errp);
+}
