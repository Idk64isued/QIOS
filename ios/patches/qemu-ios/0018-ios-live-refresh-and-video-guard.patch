+/* --- live refresh rate ----------------------------------------------------- */
+/*
+ * The panel's frame rate while running: the iOS app drops it to 30 Hz when the phone gets hot (half the frames for
+ * the guest's Core Animation to draw and for the app to present) and back to 60 when it has cooled. Every panel
+ * with a "live-refresh-hz" (the S5L8930 display, the iPod touch LCD) takes it at its next frame.
+ */
+static int set_refresh_one(Object *obj, void *opaque)
+{
+    if (object_property_find(obj, "live-refresh-hz")) {
+        object_property_set_uint(obj, "live-refresh-hz", (uintptr_t)opaque, NULL);
+    }
+    return 0;
+}
+
+static void refresh_bh(void *opaque)
+{
+    object_child_foreach_recursive(object_get_root(), set_refresh_one, opaque);
+}
+
+bool qemu_ios_ui_set_refresh_hz(unsigned hz)
+{
+    if (!qemu_ios_ui_ready() || hz < 1 || hz > 240) {
+        return false;
+    }
+    aio_bh_schedule_oneshot(qemu_get_aio_context(), refresh_bh, (void *)(uintptr_t)hz);
+    return true;
+}
