 #include <OpenGLES/ES1/gl.h>
 #include <OpenGLES/ES1/glext.h>
+/*
+ * iOS only has the ES 1.1 headers, which lack tokens this renderer also uses
+ * for the desktop GL (CGL) host: cube maps and pixel-store row length (ES 2/3 or
+ * *_OES), packed 8888 types, depth-component and range limits, and the desktop
+ * state-query enums. The values are the standard GL enum values. On an ES 1.1
+ * context a query for an unsupported one raises GL_INVALID_ENUM, which the
+ * renderer already drains, so defining them is enough to compile.
+ */
+#ifndef GL_TEXTURE_CUBE_MAP
+#define GL_TEXTURE_CUBE_MAP               0x8513
+#endif
+#ifndef GL_TEXTURE_CUBE_MAP_POSITIVE_X
+#define GL_TEXTURE_CUBE_MAP_POSITIVE_X    0x8515
+#endif
+#ifndef GL_TEXTURE_CUBE_MAP_NEGATIVE_Z
+#define GL_TEXTURE_CUBE_MAP_NEGATIVE_Z    0x851A
+#endif
+#ifndef GL_UNPACK_ROW_LENGTH
+#define GL_UNPACK_ROW_LENGTH              0x0CF2
+#endif
+#ifndef GL_DEPTH_COMPONENT
+#define GL_DEPTH_COMPONENT                0x1902
+#endif
+#ifndef GL_UNSIGNED_INT_8_8_8_8
+#define GL_UNSIGNED_INT_8_8_8_8           0x8035
+#endif
+#ifndef GL_UNSIGNED_INT_8_8_8_8_REV
+#define GL_UNSIGNED_INT_8_8_8_8_REV       0x8367
+#endif
+#ifndef GL_MAX_ELEMENTS_VERTICES
+#define GL_MAX_ELEMENTS_VERTICES          0x80E8
+#endif
+#ifndef GL_MAX_ELEMENTS_INDICES
+#define GL_MAX_ELEMENTS_INDICES           0x80E9
+#endif
+#ifndef GL_QUADS
+#define GL_QUADS                          0x0007
+#endif
+#ifndef GL_FILL
+#define GL_FILL                           0x1B02
+#endif
+#ifndef GL_HALF_FLOAT
+#define GL_HALF_FLOAT                     0x140B
+#endif
+#ifndef GL_TEXTURE_MAX_LEVEL
+#define GL_TEXTURE_MAX_LEVEL              0x813D
+#endif
+#ifndef GL_TEXTURE_WIDTH
+#define GL_TEXTURE_WIDTH                  0x1000
+#endif
+#ifndef GL_TEXTURE_HEIGHT
+#define GL_TEXTURE_HEIGHT                 0x1001
+#endif
+#ifndef GL_VERTEX_PROGRAM_POINT_SIZE
+#define GL_VERTEX_PROGRAM_POINT_SIZE      0x8642
+#endif
+#ifndef GL_ALPHA_SCALE
+#define GL_ALPHA_SCALE                    0x0D1C
+#endif
+#ifndef GL_CURRENT_BIT
+#define GL_CURRENT_BIT                    0x00000001
+#endif
+#ifndef GL_POLYGON_BIT
+#define GL_POLYGON_BIT                    0x00000008
+#endif
+#ifndef GL_ENABLE_BIT
+#define GL_ENABLE_BIT                     0x00002000
+#endif
+#ifndef GL_TEXTURE_BIT
+#define GL_TEXTURE_BIT                    0x00040000
+#endif
+#ifndef GL_COMPILE_STATUS
+#define GL_COMPILE_STATUS                 0x8B81
+#endif
+#ifndef GL_LINK_STATUS
+#define GL_LINK_STATUS                    0x8B82
+#endif
+#ifndef GL_CURRENT_PROGRAM
+#define GL_CURRENT_PROGRAM                0x8B8D
+#endif
+#ifndef GL_RGB565
+#define GL_RGB565                         0x8D62
+#endif
 #endif
 
