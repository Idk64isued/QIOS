From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 22 Nov 2026 19:40:00 -0700
Subject: [PATCH] ios: a framebuffer drawing into the drawable stays the drawable

Minecraft on iOS 6.1.3 starts in portrait, rotates to landscape and is
black from then on, with the game running underneath:

  frame buffer 640x960 -> 960x640: rebuilding its IOSurface
  glFramebufferRenderbuffer(attach=0x8ce0 obj=1) on fb 2 -> DRAWABLE
  DRAWING INTO INCOMPLETE framebuffer 1 (host 1, status 0x8cd6)
  GL holds: color0=renderbuffer(1) depth=renderbuffer(2) stencil=renderbuffer(2)
  offscreen fb 1 after 20 draws -> mean rgba 0,0,0,0   (every frame)

Framebuffer 1's colour is renderbuffer 1, the one that gets its storage
from CoreAnimation's drawable -- by this host's own rule, a framebuffer
that means the drawable. Somewhere in the rebuild it stopped meaning that,
and as a plain host framebuffer its colour has no storage, so it is
INCOMPLETE_ATTACHMENT and every one of the game's twenty draws a frame is
thrown away.

* The incomplete-framebuffer check now applies the rule as well:
  INCOMPLETE_ATTACHMENT on a framebuffer whose colour is a renderbuffer
  that never got GL storage gives it back its meaning as the drawable
  (logged once as fb-redrawable).
* Deleting the bound framebuffer binds 0, as GL says, for the drawable
  too: the check came after the drawable's name was zeroed for the host,
  so the binding stayed on a name the guest had let go of.
* The incomplete-framebuffer report now lists the last 24 framebuffer
  and renderbuffer operations -- gens, binds, storage, deletes and
  attachments, in order -- not just the last 8 attachments, so if this
  is not the whole story the next log tells the rest.
---
diff --git a/hw/arm/gles-host.c b/hw/arm/gles-host.c
index 19b210b..5b13f52 100644
--- a/hw/arm/gles-host.c
+++ b/hw/arm/gles-host.c
@@ -1529,7 +1529,7 @@ typedef struct {
     bool skipped;           /* the framebuffer meant the drawable: no GL call */
 } GlesAttachNote;
 
-#define GLES_ATTACH_LOG 8
+#define GLES_ATTACH_LOG 24
 static GlesAttachNote gles_attach_log[GLES_ATTACH_LOG];
 static unsigned gles_attach_n;
 
@@ -3212,6 +3212,41 @@ static void gles_check_fb_complete(void)
         }
     }
 
+    /*
+     * INCOMPLETE_ATTACHMENT (0x8cd6) with the CA drawable's renderbuffer as its colour: a framebuffer whose colour
+     * is a renderbuffer that never got GL storage means the drawable, by the same rule glFramebufferRenderbuffer
+     * applies -- that renderbuffer has no storage of its own on this host, which is exactly what makes the host
+     * framebuffer incomplete. Minecraft lands here after it rotates to landscape: it rebuilds its drawable, the
+     * framebuffer it goes on drawing into loses its "drawable" meaning on the way, and every frame after that is
+     * thrown away (a black screen with the game running underneath). Give it the meaning back.
+     */
+    if (st == 0x8cd6 && !gles_is_drawable(gh.bound_framebuffer)) {
+        uint32_t name = gh.bound_framebuffer;
+        GLint kind = 0, obj = 0;
+
+        while (glGetError() != GL_NO_ERROR) {
+        }
+        glGetFramebufferAttachmentParameterivEXT(GL_FRAMEBUFFER_EXT, GL_COLOR_ATTACHMENT0_EXT,
+                                                 GL_FRAMEBUFFER_ATTACHMENT_OBJECT_TYPE_EXT, &kind);
+        if (kind == GL_RENDERBUFFER_EXT) {
+            glGetFramebufferAttachmentParameterivEXT(GL_FRAMEBUFFER_EXT, GL_COLOR_ATTACHMENT0_EXT,
+                                                     GL_FRAMEBUFFER_ATTACHMENT_OBJECT_NAME_EXT, &obj);
+        }
+        if (kind == GL_RENDERBUFFER_EXT && obj && !g_hash_table_contains(gh.rb_sized, GUINT_TO_POINTER(obj))) {
+            gles_set_drawable(name, true);
+            glBindFramebufferEXT(GL_FRAMEBUFFER_EXT, gles_host_fbo(name));
+            st = glCheckFramebufferStatusEXT(GL_FRAMEBUFFER_EXT);
+            if (gles_refuse("fb-redrawable:%u", name)) {
+                fprintf(stderr, "[gles] framebuffer %u draws into the drawable's renderbuffer %d and had lost its "
+                        "meaning as the drawable; it has it back and is %s\n", name, obj,
+                        st == GL_FRAMEBUFFER_COMPLETE_EXT ? "complete" : "STILL INCOMPLETE");
+            }
+            if (st == GL_FRAMEBUFFER_COMPLETE_EXT) {
+                return;
+            }
+        }
+    }
+
     if (gles_refuse("fb-incomplete:0x%x", st)) {
         size_t i;
         bool any_attach = gles_seen(677) || gles_seen(679);
@@ -3235,12 +3270,23 @@ static void gles_check_fb_complete(void)
                 : "NO attachment call has ever reached the host -- the guest never sent one, "
                   "so its dispatch slot is one of the unnamed ones");
 
-        /* What this host was asked to attach, most recent last. */
+        /* What this host was asked to do with framebuffers and renderbuffers, most recent last. */
         for (i = 0; i < GLES_ATTACH_LOG && i < gles_attach_n; i++) {
             unsigned k = (gles_attach_n - MIN(gles_attach_n, GLES_ATTACH_LOG) + i)
                          % GLES_ATTACH_LOG;
             const GlesAttachNote *n = &gles_attach_log[k];
 
+            if (strncmp(n->what, "glFramebuffer", 13) != 0) {
+                /* Not an attachment: a gen, bind, storage or delete, in order with them. */
+                if (n->attach) {   /* glRenderbufferStorage: the format */
+                    fprintf(stderr, "[gles]   then: %s(%u, format 0x%x) with fb %u bound\n", n->what, n->obj,
+                            n->attach, n->fb);
+                } else {
+                    fprintf(stderr, "[gles]   then: %s(%u) with fb %u bound%s\n", n->what, n->obj, n->fb,
+                            n->skipped ? "  [the drawable]" : "");
+                }
+                continue;
+            }
             fprintf(stderr, "[gles]   asked: %s(attach=0x%x obj=%u%s) on fb %u%s\n",
                     n->what, n->attach, n->obj,
                     n->textarget ? " tex2d" : "", n->fb,
@@ -9229,6 +9275,10 @@ static int64_t gles_host_call_1(CPUState *cpu, uint32_t slot, uint32_t ctx,
         } else {
             glGenFramebuffersEXT(n, ids);
         }
+        for (uint32_t k = 0; k < n && k < 4; k++) {
+            gles_attach_note(slot == GLES_SLOT_GEN_RENDERBUFFERS ? "glGenRenderbuffers" : "glGenFramebuffers",
+                             0, ids[k], 0, false);
+        }
         if (a[1] && n) {
             gles_guest_rw(cpu, a[1], (uint8_t *)ids,
                                 n * sizeof(GLuint), 1);
@@ -9327,6 +9377,9 @@ static int64_t gles_host_call_1(CPUState *cpu, uint32_t slot, uint32_t ctx,
                     vp[0], vp[1], vp[2], vp[3]);
         }
         gh.offscreen_draws_here = 0;
+        if (a[1] != gh.bound_framebuffer) {
+            gles_attach_note("glBindFramebuffer", 0, a[1], 0, gles_is_drawable(a[1]));
+        }
         gh.bound_framebuffer = a[1];
         gh.fb_dirty = true;
         glBindFramebufferEXT(GL_FRAMEBUFFER_EXT, gles_host_fbo(a[1]));
@@ -9349,6 +9402,7 @@ static int64_t gles_host_call_1(CPUState *cpu, uint32_t slot, uint32_t ctx,
          * its own from -renderbufferStorage:fromDrawable:, outside GL. */
         g_hash_table_add(gh.rb_sized,
                          GUINT_TO_POINTER(gh.bound_renderbuffer));
+        gles_attach_note("glRenderbufferStorage", a[1], gh.bound_renderbuffer, 0, false);
         gles_texture_begin();
         glRenderbufferStorageEXT(GL_RENDERBUFFER_EXT,
                                  gles_rb_format(a[1]), a[2], a[3]);
@@ -9443,6 +9497,7 @@ static int64_t gles_host_call_1(CPUState *cpu, uint32_t slot, uint32_t ctx,
         }
         if (slot == GLES_SLOT_DELETE_RENDERBUFFERS) {
             for (i = 0; i < n; i++) {
+                gles_attach_note("glDeleteRenderbuffers", 0, ids[i], 0, false);
                 g_hash_table_remove(gh.rb_sized, GUINT_TO_POINTER(ids[i]));
                 if (ids[i]) {
                     gles_charge(gles_charge_table(false),
@@ -9452,6 +9507,16 @@ static int64_t gles_host_call_1(CPUState *cpu, uint32_t slot, uint32_t ctx,
             glDeleteRenderbuffersEXT(n, ids);
         } else {
             for (i = 0; i < n; i++) {
+                gles_attach_note("glDeleteFramebuffers", 0, ids[i], 0, gles_is_drawable(ids[i]));
+                /*
+                 * GL: deleting the bound framebuffer binds 0 -- the drawable one included. This check used to
+                 * come after the name below was zeroed, so deleting the bound drawable left the binding on a
+                 * name the guest had let go of.
+                 */
+                if (ids[i] && ids[i] == gh.bound_framebuffer) {
+                    gh.bound_framebuffer = 0;
+                    gh.fb_dirty = true;
+                }
                 /* Never let the guest delete gh.fbo out from under the
                  * present path by deleting the name that stands for it. */
                 if (g_hash_table_remove(gh.fbo_drawable,
