+/*
+ * Non-power-of-two 2D textures on an ES host.
+ *
+ * Apple's ES samples a 2D texture whose width or height is not a power of two only when it clamps to the edge and
+ * has no mipmaps (APPLE_texture_2D_limited_npot); otherwise the texture is incomplete, and ES draws an incomplete
+ * texture as if texturing were off: the fragment keeps its own color, which for CoreAnimation's quads is white.
+ * The desktop has no such rule, so nothing here enforced one, and every NPOT layer, icon and render target that kept
+ * GL's defaults (REPEAT, NEAREST_MIPMAP_LINEAR) drew as a white box. A texture that gets an NPOT level 0 is clamped
+ * and loses its mipmap filter, here and at every later glTexParameter, as rectangles already are; a POT surface
+ * gets MAX_LEVEL 0 (APPLE_texture_max_level), which the guest-upload path already gives guest textures.
+ */
+static GHashTable *gles_npot;           /* host names of 2D textures whose level 0 is NPOT */
+static unsigned gles_npot_logged;
+
+static bool gles_is_pot(uint32_t v)
+{
+    return v && !(v & (v - 1));
+}
+
+static bool gles_npot_bound(void)
+{
+    GLint name = 0;
+
+    if (!gles_npot || !g_hash_table_size(gles_npot)) {
+        return false;
+    }
+    glGetIntegerv(GL_TEXTURE_BINDING_2D, &name);
+    return name && g_hash_table_contains(gles_npot, GUINT_TO_POINTER(name));
+}
+
+/* The 2D texture bound now has (or is about to have) a level 0 of w x h. */
+static void gles_npot_note_bound(uint32_t w, uint32_t h, bool surface)
+{
+    GLint name = 0, ws = 0, wt = 0, minf = 0;
+    bool changed = false;
+
+    glGetIntegerv(GL_TEXTURE_BINDING_2D, &name);
+    if (!name || (gles_rects && g_hash_table_contains(gles_rects, GUINT_TO_POINTER(name)))) {
+        return;                         /* rectangles keep their own rules (gles_rect_bound) */
+    }
+    if (gles_is_pot(w) && gles_is_pot(h)) {
+        if (gles_npot) {
+            g_hash_table_remove(gles_npot, GUINT_TO_POINTER(name));
+        }
+        if (surface) {
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAX_LEVEL, 0);
+            while (glGetError() != GL_NO_ERROR) {
+            }
+        }
+        return;
+    }
+    if (!gles_npot) {
+        gles_npot = g_hash_table_new(g_direct_hash, g_direct_equal);
+    }
+    g_hash_table_add(gles_npot, GUINT_TO_POINTER(name));
+    glGetTexParameteriv(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, &ws);
+    glGetTexParameteriv(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, &wt);
+    glGetTexParameteriv(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, &minf);
+    if (ws != GL_CLAMP_TO_EDGE) {
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        changed = true;
+    }
+    if (wt != GL_CLAMP_TO_EDGE) {
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+        changed = true;
+    }
+    if (minf >= 0x2700 && minf <= 0x2703) {
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, (minf & 1) ? GL_LINEAR : GL_NEAREST);
+        changed = true;
+    }
+    while (glGetError() != GL_NO_ERROR) {
+    }
+    if (changed && gles_npot_logged < 24) {
+        gles_npot_logged++;
+        fprintf(stderr, "[gles] npot texture %d %ux%u%s: clamped, no mipmaps (was wrap 0x%x/0x%x min 0x%x)\n",
+                name, w, h, surface ? " (surface)" : "", ws, wt, minf);
+    }
+}
 #endif /* rectangle textures on an ES 1.1 host */
 
