+#ifndef GLES_HOST_ANGLE
+/*
+ * Apple's own ES on an iOS host is stricter than the desktop GL this file was written against, in two ways that
+ * cost a whole texture each:
+ *
+ *  - glTexImage2D's internal format has to equal its format (BGRA: GL_RGBA storage, APPLE_texture_format_BGRA8888).
+ *    The desktop takes GL_RGBA storage for any format, and so did every upload here: an A8, L8, LA88 or 565 surface
+ *    (status bar text, shadows, opaque layers) and a decoded PVRTC RGB texture were GL_INVALID_OPERATION.
+ *  - ES 1.1 and 2.0 have no GL_UNPACK_ROW_LENGTH (it is ES 3.0). Setting it to 0, its default, raised
+ *    GL_INVALID_ENUM, which the next error check took for the upload's own failure or handed to the guest.
+ */
+static inline void gles_eagl_tex_image_2d(GLenum target, GLint level, GLint internal, GLsizei w, GLsizei h,
+                                          GLint border, GLenum format, GLenum type, const void *pixels)
+{
+    (void)internal;
+    (glTexImage2D)(target, level, format == GL_BGRA ? GL_RGBA : (GLint)format, w, h, border, format, type, pixels);
+}
+#define glTexImage2D gles_eagl_tex_image_2d
+
+static inline void gles_eagl_pixel_store(GLenum pname, GLint value)
+{
+    if ((pname == 0x0CF2 /* UNPACK_ROW_LENGTH */ || pname == 0x0D02 /* PACK_ROW_LENGTH */) && value == 0) {
+        return;                         /* the default, and the only value an ES 1.1 guest can mean */
+    }
+    (glPixelStorei)(pname, value);
+}
+#define glPixelStorei gles_eagl_pixel_store
+#endif
